# Public site URL (include base path on GitHub Pages)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set automatically in GitHub Actions for project Pages:
# NEXT_PUBLIC_BASE_PATH=/cerhera-nail

# Supabase (browser + Edge Functions)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Optional override; defaults to $NEXT_PUBLIC_SUPABASE_URL/functions/v1
# NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL=https://YOUR_PROJECT.supabase.co/functions/v1

# Comma-separated admin emails (public allowlist for magic-link UI)
NEXT_PUBLIC_ADMIN_EMAILS=you@example.com

# --- Supabase Edge Function secrets (set with `supabase secrets set`) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SUPABASE_SERVICE_ROLE_KEY=...
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
